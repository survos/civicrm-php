{
    "name": "survos/civicrm-php",
    "description": "CiviCRM APIv4 REST client. Framework-agnostic -- usable from Symfony, WordPress, or plain PHP.",
    "license": "MIT",
    "keywords": ["civicrm", "api", "crm", "apiv4"],
    "authors": [
        {
            "name": "Tac Tacelosky",
            "email": "tacman@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "psr/log": "^3.0",
        "symfony/http-client-contracts": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "symfony/http-client": "^8.1"
    },
    "suggest": {
        "symfony/http-client": "A PSR-compatible HttpClientInterface implementation; any implementation will do."
    },
    "autoload": { "psr-4": { "Survos\\Civicrm\\": "src/" } },
    "autoload-dev": { "psr-4": { "Survos\\Civicrm\\Tests\\": "tests/" } },
    "config": { "sort-packages": true },
    "minimum-stability": "stable"
}
